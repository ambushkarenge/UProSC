{
  // Cloudflare Workers + Static Assets + D1 configuration for UProSC.
  // Before deploying Phase 3B to Cloudflare, create your D1 database once:
  //   npx wrangler d1 create uprosc-db
  // Replace `database_id` below with the returned UUID, then apply migrations:
  //   npx wrangler d1 migrations apply uprosc-db --remote
  "name": "uprosc",
  "main": "worker/index.ts",
  "compatibility_date": "2026-01-15",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "uprosc-db",
      "database_id": "39de7fe8-4ea0-4a34-819c-72098973e60d",
      "migrations_dir": "migrations"
    }
  ]
}
